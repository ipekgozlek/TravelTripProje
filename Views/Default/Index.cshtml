@using TravelTripProje.Models.Siniflar
@model List<Blog>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}


<!--
Author: W3layouts
Author URL: http://w3layouts.com
License: Creative Commons Attribution 3.0 Unported
License URL: http://creativecommons.org/licenses/by/3.0/
-->
<!DOCTYPE HTML>
<html>

<body>

    
    <div class="header-banner">
        <div class="wrap">
            <div class="banner">
                <div class="indent">
                    <h2 class="indent-left margin-bot" style="margin-left:80px">Tatil & Seyahat Bloğum</h2>
                    <div class="banner-left">
                        <div class="con-text">
                            <div class="grid1-img">
                                <img src="~/web/images/glass.png" alt="">
                            </div>
                            <div class="grid1-desc">
                                <p>Restaurantlar</p>
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="con-text">
                            <div class="grid1-img">
                                <img src="~/web/images/flight.png" alt="">
                            </div>
                            <div class="grid1-desc">
                                <p>Uçuşlar</p>
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="con-text">
                            <div class="grid1-img">
                                <img src="~/web/images/group.png" alt="">
                            </div>
                            <div class="grid1-desc">
                                <p>Yapılacaklar</p>
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="con-text">
                            <div class="grid1-img">
                                <img src="~/web/images/key.png" alt="">
                            </div>
                            <div class="grid1-desc">
                                <p>Araba Kiralama</p>
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="clear"></div>
                    </div>
                    <div class="header_bottom_right_images">

                        <div class="slider" style="width: 650px; height: 350px; overflow: hidden;">
                            <ul class="rslides" id="slider1" style="height:350px;">
                                @foreach (var x in Model)
                                {
                                <li style="height:350px;">
                                <img src="@x.BlogImage" alt="" style="width:650px; height:350px; object-fit:cover;" />
                                </li>
                                @*<li><img src="~/web/images/img2.jpg" alt=""></li>
                                <li><img src="~/web/images/img3.jpg" alt=""></li>
                                <li><img src="~/web/ images/img4.jpg" alt=""></li>*@
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clear"></div>
            </div>
            <div class="clear"></div>
        </div>
    </div>
    <div class"content">
        <div class="wrap">
            <div class="wrapper">
                <div class="con-top">
                    <h3>Seyahat Tutkunlarının Buluşma Noktasına Hoş Geldiniz!</h3>
                    <p>Yeni yerler keşfetmek, farklı kültürleri tanımak ve unutulmaz anılar biriktirmek için yola çıkmaya hazır mısınız? Bu blogda keşfettiğim şehirleri, gezilecek yerleri, lezzet duraklarını ve seyahat deneyimlerimi sizlerle paylaşıyorum. İlham veren gezi rotaları, tatil önerileri ve küçük seyahat ipuçlarıyla bir sonraki maceranıza birlikte hazırlanıyoruz. Çünkü dünya keşfedilmeyi bekleyen güzelliklerle dolu!</p>
                </div>
                @Html.Action("Partial1", "Default")

               
                <div class="grids">
                    <div class="box1">
                        @Html.Action("Partial2", "Default")
                     
                        @Html.Action("Partial3", "Default")
                        <div class="clear"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
