@using TravelTripProje.Models.Siniflar
@model List<Blog>

<div class="con-bot">
    @{ int i = 0; }

    @foreach (var x in Model)
    {
        i++;
        <div class="left" style="@(i % 3 == 0 ? "margin-right:0;" : "")">
            <div class="bot-left">
                <img src="@x.BlogImage" alt="Place 1" style="width:100%; height:180px; object-fit:cover; display:block;" />
            </div>
            <div class="left-text">
                <h4>@x.Baslik</h4>
                <span class="doller">@x.Tarih.ToString("dd.MM.yyyy")</span>
                <p>
                    @(x.Aciklama.Substring(0, 80) + "..." )
                </p>
                <a href="/Blog/BlogDetay/@x.ID" class="read">Devamını Oku &gt;&gt;</a>
            </div>
        </div>
    }



    <div class="clear"></div>
</div>